# Copie para .env e preencha. O .env fica fora do git.

# Domínio que aponta para este servidor (sem https://). O Caddy pega o certificado sozinho.
DOMAIN=clawd.seusite.com.br

# Primeiro usuário. Se o usuário já existir, a senha é atualizada para esta ao iniciar.
# Mínimo de 8 caracteres. Depois de criar, pode apagar a senha daqui (o hash fica no volume).
CLAWDDESK_ADMIN_USER=admin
CLAWDDESK_ADMIN_PASSWORD=

# Fuso horário usado na linha do tempo de "hoje".
TZ=America/Sao_Paulo

# Nome deste servidor nos terminais dos PCs ligados.
CLAWDDESK_NAME=Servidor

# Portas no servidor (troque só se 80/443 já estiverem em uso).
# HTTP_PORT=80
# HTTPS_PORT=443
